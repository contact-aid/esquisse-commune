# --- Envoi des demandes de réservation ---

# SMTP prioritaire lorsqu'il est configuré (SSL/TLS sur le port 465)
# SMTP_HOST="mail.aidhabitat.fr"
# SMTP_PORT="465"
# SMTP_USER="lesquissecommune@aidhabitat.fr"
# SMTP_PASSWORD="mot_de_passe_a_renseigner_uniquement_sur_le_serveur"
# RESERVATION_MAIL_FROM="L'esquisse commune <lesquissecommune@aidhabitat.fr>"
# Les variables SMTP sont privées : ne jamais utiliser le préfixe VITE_.

# Clé API Resend utilisée par la fonction Vercel /api/reservation
RESEND_API_KEY="re_votre_cle_api"

# Adresse d'envoi utilisée comme expéditeur du mail
RESERVATION_MAIL_FROM="L'esquisse commune <no-respond@esquisse.aidhabitat.fr>"

# Destinataire des demandes
RESERVATION_MAIL_TO="lesquissecommune@gmail.com"

# --- Configuration Stripe prévue pour une étape suivante ---

VITE_STRIPE_PUBLIC_KEY="pk_test_votre_cle_publique_stripe"
# STRIPE_SECRET_KEY="sk_test_votre_cle_secrete_stripe"

# --- Mesure d'audience et de conversion Google Analytics 4 ---

# Identifiant public du flux Web GA4, format G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Webflow Headless CMS pour le blog ---

WEBFLOW_API_TOKEN="wf_votre_token"
WEBFLOW_BLOG_COLLECTION_ID="votre_collection_id"
# WEBFLOW_CMS_LOCALE_ID="votre_locale_id"

# Slugs de champs si votre collection CMS n'utilise pas les noms par défaut
# WEBFLOW_BLOG_EXCERPT_FIELD="excerpt"
# WEBFLOW_BLOG_CONTENT_FIELD="content"
# WEBFLOW_BLOG_COVER_IMAGE_FIELD="cover-image"
# WEBFLOW_BLOG_OG_IMAGE_FIELD="og-image"
# WEBFLOW_BLOG_SEO_TITLE_FIELD="seo-title"
# WEBFLOW_BLOG_SEO_DESCRIPTION_FIELD="seo-description"
# WEBFLOW_BLOG_PUBLISHED_AT_FIELD="published-at"
